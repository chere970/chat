# Relay — local development defaults
# Copy to .env and fill in your values:  cp .env.example .env
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me-before-deploy
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SMS Backend — "afromessage", "twilio", or "console" (auto-detected if empty)
SMS_BACKEND=

# AfroMessage (recommended for Ethiopia) — https://afromessage.com
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=

# Twilio (global) — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
